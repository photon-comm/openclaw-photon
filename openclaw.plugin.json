{
  "id": "photon",
  "name": "Photon",
  "description": "iMessage channel for OpenClaw through Photon Spectrum. No Mac and no public URL needed.",
  "categories": [
    "channels"
  ],
  "activation": {
    "onStartup": false
  },
  "channels": [
    "photon"
  ],
  "channelEnvVars": {
    "photon": [
      "PHOTON_PROJECT_ID",
      "PHOTON_PROJECT_SECRET"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "photon": {
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "defaultAccount": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "projectId": {
            "type": "string"
          },
          "projectSecret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "env"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "store"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "file"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "const": "exec"
                      },
                      "provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "source",
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            ]
          },
          "dmPolicy": {
            "default": "pairing",
            "type": "string",
            "enum": [
              "pairing",
              "allowlist",
              "open",
              "disabled"
            ]
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "defaultTo": {
            "type": "string"
          },
          "reactions": {
            "type": "boolean"
          },
          "markdown": {
            "type": "object",
            "properties": {
              "tables": {
                "type": "string",
                "enum": [
                  "off",
                  "bullets",
                  "code",
                  "block"
                ]
              }
            },
            "additionalProperties": false
          },
          "historyLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dmHistoryLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contextVisibility": {
            "type": "string",
            "enum": [
              "all",
              "allowlist",
              "allowlist_quote"
            ]
          },
          "dms": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "historyLimit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            }
          },
          "textChunkLimit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "streaming": {
            "type": "object",
            "properties": {
              "chunkMode": {
                "type": "string",
                "enum": [
                  "length",
                  "newline"
                ]
              },
              "block": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "coalesce": {
                    "type": "object",
                    "properties": {
                      "minChars": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "maxChars": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "idleMs": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "responsePrefix": {
            "type": "string"
          },
          "mediaMaxMb": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "dmPolicy"
        ],
        "additionalProperties": false
      },
      "uiHints": {
        "": {
          "label": "Photon",
          "help": "iMessage through Photon Spectrum. Photon hosts the iMessage lines, so no Mac or public URL is needed."
        },
        "projectId": {
          "label": "Photon project ID",
          "help": "Project ID from your project's Settings at https://app.photon.codes."
        },
        "projectSecret": {
          "label": "Photon project secret",
          "help": "Project secret from the same Settings page.",
          "sensitive": true
        },
        "dmPolicy": {
          "label": "DM policy",
          "help": "Who can message the agent. \"pairing\" (default) asks unknown numbers to pair; \"allowlist\" only allows allowFrom; \"open\" needs allowFrom [\"*\"]."
        },
        "allowFrom": {
          "label": "Allowed phone numbers",
          "help": "Phone numbers in E.164 format (for example +15551234567) that can message the agent."
        },
        "reactions": {
          "label": "Tapback status",
          "help": "Tapback 👀 while the agent works and 👍 or 👎 when it finishes, and pass your tapbacks on the agent's messages to the agent. Off by default."
        }
      },
      "label": "Photon",
      "description": "iMessage through Photon Spectrum"
    }
  }
}
