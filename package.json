{
  "name": "@photon-ai/openclaw-photon",
  "version": "0.2.0",
  "description": "Photon iMessage channel plugin for OpenClaw: reach your agent over iMessage through Photon, no Mac required.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/openclaw-photon.git"
  },
  "homepage": "https://github.com/photon-hq/openclaw-photon#readme",
  "bugs": {
    "url": "https://github.com/photon-hq/openclaw-photon/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "photon",
    "imessage",
    "channel",
    "messaging"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "files": [
    "dist/**",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-manifest": "tsx scripts/sync-manifest.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@photon-ai/api": "0.6.0",
    "socket.io-client": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "openclaw": "2026.11.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./setup-entry.ts",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "photon",
      "label": "Photon",
      "selectionLabel": "Photon (iMessage, no Mac)",
      "detailLabel": "Photon iMessage",
      "docsPath": "https://github.com/photon-hq/openclaw-photon#readme",
      "docsLabel": "photon",
      "blurb": "iMessage through Photon. Sign in with Photon and get a line to text, no Mac or public URL needed.",
      "aliases": [
        "photon-imessage"
      ],
      "systemImage": "message",
      "order": 57,
      "quickstartAllowFrom": true,
      "cliAddOptions": [
        {
          "flags": "--project-id <id>",
          "description": "Photon project ID (pho_prj_...)"
        },
        {
          "flags": "--api-key <key>",
          "description": "Photon project API key (pho_sk_...)"
        }
      ],
      "configuredState": {
        "env": {
          "allOf": [
            "PHOTON_PROJECT_ID",
            "PHOTON_API_KEY"
          ]
        },
        "specifier": "./dist/configured-state.js",
        "exportName": "hasPhotonConfiguredState"
      }
    },
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3"
    }
  }
}
